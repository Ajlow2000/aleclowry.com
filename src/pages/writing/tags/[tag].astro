---
import BaseLayout from "../../../components/BaseLayout.astro";
import PostList from "../../../components/blog/PostList.astro";
import { getPosts } from "../../../utils/get-posts";

export async function getStaticPaths() {
  const posts = await getPosts(({ data }) => import.meta.env.PROD ? !data.draft : true);
  const tags = new Set<string>();
  posts.forEach((post) => post.data.tags?.forEach((t) => tags.add(t)));
  return Array.from(tags).map((tag) => ({ params: { tag }, props: { tag } }));
}

const { tag } = Astro.props;
const posts = (await getPosts(({ data }) => import.meta.env.PROD ? !data.draft : true))
  .filter((p) => p.data.tags?.includes(tag))
  .sort((a, b) => b.resolvedDate.valueOf() - a.resolvedDate.valueOf());
---

<BaseLayout title={`#${tag} — Alec Lowry`}>
  <div class="container tag-page">
    <span class="eyebrow">Tag</span>
    <h1>#{tag}</h1>
    <PostList posts={posts} />
  </div>
</BaseLayout>

<style>
  .tag-page { padding: 56px 0 80px; }
  .tag-page h1 { font-size: 36px; margin: 12px 0 32px; }
</style>
