---
import { render } from "astro:content";
import BlogPost from "../../components/blog/BlogPost.astro";
import { getPosts } from "../../utils/get-posts";
import type { ResolvedPost } from "../../utils/get-posts";
import { postSlug } from "../../utils/format";

export async function getStaticPaths() {
  const posts = await getPosts(({ data }) => import.meta.env.PROD ? !data.draft : true);
  return posts.map((post) => ({
    params: { slug: postSlug(post.id) },
    props: { post },
  }));
}

const { post }: { post: ResolvedPost } = Astro.props;
const { Content, headings } = await render(post);
---

<BlogPost title={post.resolvedTitle} date={post.resolvedDate} description={post.data.description} post={post} headings={headings}>
  <Content />
</BlogPost>
