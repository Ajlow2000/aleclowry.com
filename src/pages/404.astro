---
import BaseLayout from "../components/BaseLayout.astro";
import { getEntry } from "astro:content";

const page = await getEntry("pages", "404");
const lede = page?.data.lede ?? "The requested page doesn't exist.";
---

<BaseLayout title="404 — Alec Lowry">
  <div class="container notfound">
    <p class="number">404<span class="dot" aria-hidden="true"></span></p>
    <p class="lede">{lede}</p>
    <div class="actions">
      <a href="/" class="btn btn-primary">Home</a>
    </div>
  </div>
</BaseLayout>

<style>
  .notfound {
    flex: 1;
    display: flex; flex-direction: column; align-items: flex-start;
    justify-content: center;
    padding: 80px 0;
  }
  .number {
    font-family: var(--f-ui); font-weight: 700;
    font-size: clamp(120px, 22vw, 200px);
    line-height: 0.9; letter-spacing: -0.04em;
    margin: 0; color: var(--ink);
    display: inline-flex; align-items: flex-end; gap: 0.06em;
  }
  .dot {
    display: inline-block;
    width: 0.16em; height: 0.16em;
    border-radius: 999px;
    background: var(--forest);
    margin-bottom: 0.12em;
  }
  .lede {
    font-family: var(--f-ui);
    font-size: 18px; color: var(--ink-2);
    max-width: 36ch; margin: 24px 0 32px;
  }
  .actions { display: flex; gap: 12px; }
</style>
