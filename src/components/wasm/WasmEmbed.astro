---
import WasmLoading from './WasmLoading.astro';

interface Props {
  // Path or URL to the wasm-bindgen JS glue file.
  // For local dev: a same-origin path like /wasm/my-demo/test-client.js
  // For production: a full URL (typically passed in by WasmRemote)
  src: string;
  // Optional name used for element IDs. Defaults to the second-to-last path
  // segment of src (e.g. "my-demo" from ".../wasm/my-demo/test-client.js").
  name?: string;
}

const { src } = Astro.props;
const name = Astro.props.name ?? src.split('/').at(-2) ?? 'wasm';
---

<div class="wasm-embed" id={`wasm-embed-${name}`}>
  <WasmLoading />
  <div class="wasm-controls" hidden>
    <button class="wasm-btn" id={`pp-${name}`}>⏸ Pause</button>
    <button class="wasm-btn" id={`rs-${name}`}>↺ Restart</button>
  </div>
  <slot />
</div>

<script define:vars={{ src, name }}>
  (async () => {
    const container = document.getElementById(`wasm-embed-${name}`);
    const loading = container?.querySelector(".wasm-loading");
    const controls = container?.querySelector(".wasm-controls");
    const playPauseBtn = document.getElementById(`pp-${name}`);
    const restartBtn = document.getElementById(`rs-${name}`);

    try {
      // Snapshot canvases that exist before Bevy runs.
      const before = new Set(document.querySelectorAll("canvas"));

      const { default: init, pause_app, resume_app, restart_app } = await import(src);
      // No argument needed — wasm-bindgen resolves the .wasm path relative to
      // import.meta.url, so it follows src whether that's a local path or a
      // remote URL.
      await init();

      // Poll until Bevy appends its canvas to the document.
      const canvas = await new Promise((resolve) => {
        const check = () => {
          const found = [...document.querySelectorAll("canvas")].find(c => !before.has(c));
          if (found) return resolve(found);
          requestAnimationFrame(check);
        };
        check();
      });

      // Move the canvas into our container so it obeys our layout.
      container?.appendChild(canvas);
      loading?.remove();

      // Show controls now that the demo is running.
      if (controls) controls.removeAttribute("hidden");

      let isPaused = false;

      playPauseBtn?.addEventListener("click", () => {
        isPaused = !isPaused;
        if (isPaused) {
          pause_app();
          playPauseBtn.textContent = "▶ Play";
        } else {
          resume_app();
          playPauseBtn.textContent = "⏸ Pause";
        }
      });

      restartBtn?.addEventListener("click", () => {
        restart_app();
        // If paused, resume so the restarted sim immediately runs.
        if (isPaused) {
          resume_app();
          isPaused = false;
          if (playPauseBtn) playPauseBtn.textContent = "⏸ Pause";
        }
      });
    } catch (err) {
      console.error(`[WasmEmbed] Failed to load "${src}":`, err);
      if (container) container.innerHTML = `<p class="wasm-error">Failed to load demo.</p>`;
      container?.dispatchEvent(new CustomEvent('wasm:error', { bubbles: true }));
    }
  })();
</script>

<style>
  .wasm-embed {
    width: 100%;
    max-width: 720px;
    margin: 1.5em auto;
    aspect-ratio: 16 / 9;
    background: var(--bg-2);
    border: 1px solid var(--line);
    border-radius: 8px;
    overflow: hidden;
    position: relative;
  }

  /*
   * :global() is required because the canvas is created by Bevy at runtime
   * and moved into the container via JS — it never receives Astro's scoped
   * data attribute, so a normal scoped rule would never match it.
   *
   * !important is required because Bevy/winit sets inline styles on the canvas
   * (e.g. style="width: 1920px; height: 1080px") to reflect its internal window
   * size. In the CSS cascade, !important in a stylesheet beats a non-important
   * inline style set by JavaScript, so this wins without fighting Bevy's JS.
   */
  :global(.wasm-embed canvas) {
    width: 100% !important;
    height: 100% !important;
    display: block;
    outline: none;
  }

  .wasm-error {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0;
    font-family: var(--f-ui);
    font-size: 13px;
    color: var(--ink-3);
  }

  .wasm-error { color: var(--ink-4); }

  /* Controls overlay — fades in on hover so it doesn't distract from the demo. */
  .wasm-controls {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    display: flex;
    gap: 6px;
    padding: 6px 8px;
    background: linear-gradient(transparent, color-mix(in srgb, var(--bg) 70%, transparent));
    opacity: 0;
    transition: opacity 0.15s ease;
    pointer-events: none;
  }

  .wasm-embed:hover .wasm-controls {
    opacity: 1;
    pointer-events: auto;
  }

  .wasm-btn {
    font-family: var(--f-ui);
    font-size: 12px;
    padding: 3px 8px;
    border-radius: 4px;
    border: 1px solid var(--line);
    background: color-mix(in srgb, var(--bg-2) 85%, transparent);
    color: var(--ink);
    cursor: pointer;
    line-height: 1.5;
  }

  .wasm-btn:hover {
    background: var(--bg-2);
  }
</style>
