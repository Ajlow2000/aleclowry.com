---
import { getEntry } from "astro:content";
import Nav from "./Nav.astro";
import Footer from "./Footer.astro";

interface Props {
  title: string;
  description?: string;
  ogType?: string;
}

const { title, description, ogType = "website" } = Astro.props;
const currentPath = Astro.url.pathname;

const [navEntry, siteEntry] = await Promise.all([
  getEntry("pages", "nav"),
  getEntry("pages", "site"),
]);
const navLinks = navEntry?.data.links ?? [];
const siteTitle = siteEntry?.data.siteTitle ?? "alec lowry";
const socialLinks = siteEntry?.data.socialLinks ?? [];
const copyright = siteEntry?.data.copyright ?? `© ${new Date().getFullYear()} Alec Lowry`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.jpg" type="image/jpeg" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:type" content={ogType} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;0,6..72,600;0,6..72,700;1,6..72,400;1,6..72,600&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />

    <script is:inline>
      (function() {
        var t = localStorage.getItem("alec-theme") || "dark";
        document.documentElement.setAttribute("data-theme", t);
      })();
    </script>
  </head>
  <body>
    <div class="app">
      <Nav siteTitle={siteTitle} navLinks={navLinks} currentPath={currentPath} />
      <div class="main-content">
        <slot />
      </div>
      <Footer copyright={copyright} socialLinks={socialLinks} />
    </div>
  </body>
</html>

<style is:global>
  /* ── Theme: Light (default) ─────────────────────────── */
  :root {
    --bg: #f6f0df;
    --bg-2: #ede5cf;
    --bg-3: #e3d9bd;
    --line: #d2c6a3;
    --line-2: #e0d6b8;
    --ink: #1f1a12;
    --ink-2: #524a37;
    --ink-3: #7e745b;
    --ink-4: #a89e80;
    --forest: oklch(0.42 0.08 150);
    --forest-2: oklch(0.42 0.08 150 / 0.12);
    --forest-3: oklch(0.42 0.08 150 / 0.05);
    --forest-strong: oklch(0.36 0.09 150);
    --code-bg: #ece2c5;
    --code-line: #d8cca8;
    --shadow: 0 1px 2px rgba(0,0,0,0.04), 0 4px 16px rgba(0,0,0,0.04);

    --f-display: "Newsreader", Georgia, serif;
    --f-body: "Newsreader", Georgia, serif;
    --f-ui: "Inter", system-ui, -apple-system, sans-serif;
    --f-mono: "JetBrains Mono", ui-monospace, monospace;
  }

  /* ── Theme: Dark ────────────────────────────────────── */
  [data-theme="dark"] {
    --bg: oklch(0.24 0.022 150);
    --bg-2: oklch(0.28 0.026 150);
    --bg-3: oklch(0.32 0.030 150);
    --line: oklch(0.38 0.032 150);
    --line-2: oklch(0.34 0.028 150);
    --ink: oklch(0.97 0.012 150);
    --ink-2: oklch(0.86 0.018 150);
    --ink-3: oklch(0.72 0.022 150);
    --ink-4: oklch(0.56 0.026 150);
    --forest: oklch(0.78 0.11 150);
    --forest-2: oklch(0.78 0.11 150 / 0.20);
    --forest-3: oklch(0.78 0.11 150 / 0.10);
    --forest-strong: oklch(0.88 0.10 150);
    --code-bg: oklch(0.28 0.026 150);
    --code-line: oklch(0.36 0.030 150);
    --shadow: 0 1px 2px rgba(0,0,0,0.3), 0 4px 16px rgba(0,0,0,0.25);
  }

  /* ── Reset & Base ───────────────────────────────────── */
  *, *::before, *::after { box-sizing: border-box; }
  html { scroll-behavior: smooth; }

  body {
    margin: 0;
    font-family: var(--f-body);
    background: var(--bg);
    color: var(--ink);
    -webkit-font-smoothing: antialiased;
    font-size: 17px;
    line-height: 1.6;
    transition: background 0.25s, color 0.25s;
  }

  a {
    color: var(--forest);
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-thickness: 1px;
    transition: color 0.15s;
  }
  a:hover {
    color: var(--forest-strong);
    text-decoration-thickness: 2px;
  }

  h1, h2, h3, h4 {
    font-family: var(--f-display);
    color: var(--ink);
    letter-spacing: -0.012em;
    line-height: 1.15;
    font-weight: 600;
  }

  ::selection { background: var(--forest-2); }

  /* ── Layout ─────────────────────────────────────────── */
  .app { min-height: 100vh; display: flex; flex-direction: column; }
  .main-content { flex: 1; display: flex; flex-direction: column; }
  .container { max-width: 720px; margin: 0 auto; padding: 0 24px; width: 100%; }
  .container-wide { max-width: 1296px; margin: 0 auto; padding: 0 32px; width: 100%; }

  /* ── Tags ───────────────────────────────────────────── */
  .tag {
    display: inline-flex; align-items: center;
    font-family: var(--f-ui); font-size: 12px; font-weight: 500;
    padding: 3px 10px; border-radius: 999px;
    border: 1px solid var(--line); color: var(--ink-2);
    background: var(--bg); text-decoration: none;
    cursor: pointer; transition: all 0.15s; user-select: none;
  }
  .tag:hover { border-color: var(--forest); color: var(--forest); background: var(--forest-3); }
  .tag.active { border-color: var(--forest); background: var(--forest-2); color: var(--forest); }
  .tag-mono { font-family: var(--f-mono); font-size: 11px; }

  /* ── Eyebrow / labels ───────────────────────────────── */
  .eyebrow {
    font-family: var(--f-ui); font-size: 11px; font-weight: 600;
    text-transform: uppercase; letter-spacing: 0.12em; color: var(--forest);
  }
  .muted { color: var(--ink-3); }
  .small { font-size: 13px; }
  .mono { font-family: var(--f-mono); font-size: 12px; color: var(--ink-3); white-space: nowrap; }

  /* ── Buttons ────────────────────────────────────────── */
  .btn {
    display: inline-flex; align-items: center; gap: 6px;
    padding: 8px 16px; border-radius: 6px;
    font-family: var(--f-ui); font-size: 14px; font-weight: 500;
    text-decoration: none; cursor: pointer; border: 1px solid transparent;
    transition: all 0.15s; white-space: nowrap;
  }
  .btn-primary { background: var(--forest); color: var(--bg); border-color: var(--forest); }
  .btn-primary:hover { background: var(--forest-strong); color: var(--bg); }
  .btn-ghost { background: transparent; color: var(--ink-2); border-color: var(--line); }
  .btn-ghost:hover { color: var(--forest); border-color: var(--forest); }

  /* ── Code blocks ────────────────────────────────────── */
  .codeblock {
    margin: 1.5em 0; border: 1px solid var(--code-line);
    border-radius: 8px; overflow: hidden;
    background: var(--code-bg); box-shadow: var(--shadow);
    max-width: 100%; min-width: 0;
  }
  .codeblock-bar {
    display: flex; justify-content: space-between; align-items: center;
    padding: 8px 14px; background: var(--bg-2);
    border-bottom: 1px solid var(--code-line);
    font-family: var(--f-mono); font-size: 11px; color: var(--ink-3);
  }
  .codeblock-bar .lang { text-transform: lowercase; letter-spacing: 0.05em; }
  .copy-btn {
    background: transparent; border: none; cursor: pointer;
    font-family: var(--f-ui); font-size: 11px; font-weight: 500;
    color: var(--ink-3); padding: 2px 6px; border-radius: 4px;
    display: flex; align-items: center; gap: 4px;
    transition: color 0.15s, background 0.15s;
  }
  .copy-btn:hover { color: var(--forest); background: var(--forest-3); }
  .copy-btn.copied { color: var(--forest); }

  .codeblock pre {
    margin: 0; padding: 16px 18px; overflow-x: auto;
    font-family: var(--f-mono); font-size: 13px; line-height: 1.55;
    color: var(--ink);
    scrollbar-width: thin;
    scrollbar-color: var(--code-line) var(--code-bg);
  }
  .codeblock pre::-webkit-scrollbar { height: 6px; }
  .codeblock pre::-webkit-scrollbar-track { background: var(--code-bg); }
  .codeblock pre::-webkit-scrollbar-thumb {
    background: var(--code-line); border-radius: 3px;
  }
  .codeblock pre::-webkit-scrollbar-thumb:hover { background: var(--ink-4); }

  .codeblock code { font-family: inherit; }

  /* Shiki bare <pre> blocks also need themed scrollbars */
  .astro-code {
    scrollbar-width: thin;
    scrollbar-color: var(--code-line) var(--code-bg);
  }
  .astro-code::-webkit-scrollbar { height: 6px; }
  .astro-code::-webkit-scrollbar-track { background: var(--code-bg); }
  .astro-code::-webkit-scrollbar-thumb {
    background: var(--code-line); border-radius: 3px;
  }
  .astro-code::-webkit-scrollbar-thumb:hover { background: var(--ink-4); }

  /* Shiki dual-theme switching */
  html[data-theme="dark"] .astro-code,
  html[data-theme="dark"] .astro-code span {
    color: var(--shiki-dark) !important;
    background-color: var(--shiki-dark-bg) !important;
    font-style: var(--shiki-dark-font-style) !important;
    font-weight: var(--shiki-dark-font-weight) !important;
    text-decoration: var(--shiki-dark-text-decoration) !important;
  }
</style>
