<script>
  const iconCopy = `<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="8" height="4" x="8" y="2" rx="1" ry="1"/><path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"/></svg>`;
  const iconCopied = `<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="8" height="4" x="8" y="2" rx="1" ry="1"/><path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"/><path d="m9 14 2 2 4-4"/></svg>`;

  function makeCopyBtn(pre: HTMLPreElement): HTMLButtonElement {
    const btn = document.createElement("button");
    btn.className = "copy-btn";
    btn.innerHTML = `${iconCopy} Copy`;
    btn.addEventListener("click", async () => {
      const code = pre.querySelector("code")?.textContent ?? pre.textContent ?? "";
      try { await navigator.clipboard.writeText(code); }
      catch {
        const ta = document.createElement("textarea");
        ta.value = code; document.body.appendChild(ta);
        ta.select(); document.execCommand("copy"); document.body.removeChild(ta);
      }
      btn.innerHTML = `${iconCopied} Copied`;
      btn.classList.add("copied");
      setTimeout(() => { btn.innerHTML = `${iconCopy} Copy`; btn.classList.remove("copied"); }, 1600);
    });
    return btn;
  }

  document.querySelectorAll<HTMLPreElement>(".post-body pre").forEach(pre => {
    if (pre.closest(".codeblock")) return;

    const lang = pre.getAttribute("data-language") ?? "";

    const filenameWrapper = pre.closest(".code-with-filename");
    if (filenameWrapper) {
      const bar = filenameWrapper.querySelector(".code-filename");
      if (bar) {
        bar.classList.add("codeblock-bar");
        bar.appendChild(makeCopyBtn(pre));
      }
      filenameWrapper.classList.add("codeblock");
      return;
    }

    const wrapper = document.createElement("div");
    wrapper.className = "codeblock";
    const bar = document.createElement("div");
    bar.className = "codeblock-bar";
    bar.innerHTML = `<span class="lang">${lang}</span>`;
    bar.appendChild(makeCopyBtn(pre));
    pre.parentNode!.insertBefore(wrapper, pre);
    wrapper.appendChild(bar);
    wrapper.appendChild(pre);
  });
</script>

<style is:global>
  .codeblock {
    margin: 1.5em 0; border: 1px solid var(--code-line);
    border-radius: 8px; overflow: hidden;
    background: var(--code-bg); box-shadow: var(--shadow);
    max-width: 100%; min-width: 0;
  }
  .codeblock-bar {
    display: flex; justify-content: space-between; align-items: center;
    padding: 8px 14px; background: var(--bg-2);
    border-bottom: 1px solid var(--code-line);
    font-family: var(--f-mono); font-size: 11px; color: var(--ink-3);
  }
  .codeblock-bar .lang { text-transform: lowercase; letter-spacing: 0.05em; }
  .copy-btn {
    background: transparent; border: none; cursor: pointer;
    font-family: var(--f-ui); font-size: 11px; font-weight: 500;
    color: var(--ink-3); padding: 2px 6px; border-radius: 4px;
    display: flex; align-items: center; gap: 4px;
    transition: color 0.15s, background 0.15s;
  }
  .copy-btn:hover { color: var(--forest); background: var(--forest-3); }
  .copy-btn.copied { color: var(--forest); }

  .codeblock pre {
    margin: 0; padding: 16px 18px; overflow-x: auto;
    font-family: var(--f-mono); font-size: 13px; line-height: 1.55;
    color: var(--ink);
    scrollbar-width: thin;
    scrollbar-color: var(--code-line) var(--code-bg);
  }
  .codeblock pre::-webkit-scrollbar { height: 6px; }
  .codeblock pre::-webkit-scrollbar-track { background: var(--code-bg); }
  .codeblock pre::-webkit-scrollbar-thumb { background: var(--code-line); border-radius: 3px; }
  .codeblock pre::-webkit-scrollbar-thumb:hover { background: var(--ink-4); }
  .codeblock code { font-family: inherit; }

  .post-body pre {
    margin: 1.5em 0; padding: 16px 18px; overflow-x: auto;
    font-family: var(--f-mono); font-size: 13px; line-height: 1.55;
    border-radius: 8px; border: 1px solid var(--code-line);
    background: var(--code-bg);
  }
  .post-body .codeblock pre { margin: 0; border: none; border-radius: 0; }
  .post-body pre code { font-family: inherit; background: transparent; padding: 0; }

  .post-body .code-with-filename {
    border-radius: 8px; overflow: hidden;
    border: 1px solid var(--code-line); margin: 1.5em 0;
  }
  .post-body .code-filename {
    background: var(--bg-2); color: var(--ink-3);
    font-family: var(--f-mono); font-size: 11px;
    padding: 8px 14px; border-bottom: 1px solid var(--code-line);
    letter-spacing: 0.05em;
  }
  .post-body .code-filename.codeblock-bar {
    display: flex; justify-content: space-between; align-items: center;
  }
  .post-body .code-with-filename pre { border-radius: 0; margin: 0; border: none; }

  .astro-code {
    scrollbar-width: thin;
    scrollbar-color: var(--code-line) var(--code-bg);
  }
  .astro-code::-webkit-scrollbar { height: 6px; }
  .astro-code::-webkit-scrollbar-track { background: var(--code-bg); }
  .astro-code::-webkit-scrollbar-thumb { background: var(--code-line); border-radius: 3px; }
  .astro-code::-webkit-scrollbar-thumb:hover { background: var(--ink-4); }

  html[data-theme="dark"] .astro-code,
  html[data-theme="dark"] .astro-code span {
    color: var(--shiki-dark) !important;
    background-color: var(--shiki-dark-bg) !important;
    font-style: var(--shiki-dark-font-style) !important;
    font-weight: var(--shiki-dark-font-weight) !important;
    text-decoration: var(--shiki-dark-text-decoration) !important;
  }
</style>
